<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/campoServidor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://IP-DE-TU-PC:5000"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textoRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:padding="12dp"
        android:background="#1e293b"
        android:textColor="#e2e8f0"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnHablar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎤 Hablar"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/campoTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="O escribe un comando..." />

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviar" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAccesibilidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activar permiso de Accesibilidad" />

</LinearLayout>
